{
  "name": "jame-prompt-development-tools",
  "private": true,
  "description": "Repository development tooling for JamePrompt",
  "scripts": {
    "prepare": "husky",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "test:commitlint": "bash scripts/test-commitlint.sh",
    "test:pr-governance": "python3 scripts/validate_pr_description.py --self-test",
    "test:release-gate": "python3 scripts/validate_release_gate.py --self-test",
    "verify:change": "bash scripts/verify_change_gate.sh",
    "test:release-metadata": "python3 scripts/validate_release_metadata.py --self-test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7"
  }
}
