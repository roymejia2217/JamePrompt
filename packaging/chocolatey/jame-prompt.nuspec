  <metadata>
    <id>jame-prompt</id>
    <version>1.0.0</version>
    <title>JamePrompt</title>
    <authors>Roy Mejia</authors>
    <owners>Roy Mejia</owners>
    <projectUrl>https://github.com/roymejia2217/JamePrompt</projectUrl>
